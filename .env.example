# Copy this file to .env and fill in real values. .env is git-ignored — never commit real credentials.

# --- Option A: any SMTP provider (SendGrid, Outlook/Microsoft 365, Mailgun, your own mail server, ...) ---
# If SMTP_HOST/SMTP_USER/SMTP_PASSWORD are all set, this is used instead of the Gmail shortcut below.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
# Optional — defaults to SMTP_USER (or GMAIL_USER) if not set.
SMTP_FROM=no-reply@your-domain.com

# --- Option B: Gmail shortcut (used only if the SMTP_* vars above are not set) ---
# Requires 2-Step Verification enabled on the Google account, then generate an
# App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Public base URL used to build the confirmation link inside the email
# (e.g. http://localhost:5173 for local dev).
APP_BASE_URL=http://localhost:5173
